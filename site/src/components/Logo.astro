---
// The Platter mark, as drawn by PlatterMark in the Mac app.
interface Props {
  class?: string;
  tile?: boolean;
  spin?: boolean;
}
const { class: className = "size-8", tile = false, spin = false } = Astro.props;
---
<svg viewBox="0 0 200 200" class={className} aria-hidden="true">
  {tile && (
    <>
      <defs>
        <linearGradient id="platter-tile" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#303038" />
          <stop offset="1" stop-color="#1C1C21" />
        </linearGradient>
      </defs>
      <rect width="200" height="200" rx="45" fill="url(#platter-tile)" />
    </>
  )}
  <g transform={tile ? "translate(100 100) scale(0.69) translate(-100 -100)" : undefined}>
    <circle cx="100" cy="100" r="76" fill="none" stroke="#ECECF0" stroke-width="18" />
    <circle cx="100" cy="100" r="26" fill="#FFB340" />
    <g class={spin ? "animate-spin-slow origin-center [transform-box:view-box]" : undefined}>
      <rect x="93" y="8" width="14" height="40" rx="4" fill="#FFB340" transform="rotate(38 100 100)" />
    </g>
  </g>
</svg>
